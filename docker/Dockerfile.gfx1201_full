# SPDX-License-Identifier: Apache-2.0
# Full (non-copy) gfx1201 rebuild: compile aiter + vllm wheels from source.
#
# Requires a pre-built base image (Dockerfile.rocm_base) containing
# ROCm + PyTorch + Triton + FlashAttention.  Build the base first:
#   docker build -f docker/Dockerfile.rocm_base -t vllm-rocm-base:local .
#
# VERSIONING — stable tag-based (no per-commit hash chasing):
#   VLLM_BASE_VERSION = upstream version    (e.g. 0.25.0)
#   BUILD_VARIANT     = our branch/variant  (e.g. hvat-gfx1201-scratch)
#   Wheel version     = {VLLM_BASE_VERSION}+{BUILD_VARIANT}.rocmXXX
#                       (rocmXXX appended automatically by setup.py)
#
#   Git tag naming: {BUILD_VARIANT}_v{VLLM_BASE_VERSION}
#
# Build (context = the vllm source tree, with aiter as a sibling):
#
#   docker build -f docker/Dockerfile.gfx1201_full \
#       -t vllm-openai-rocm:hvat-gfx1201-scratch_v0.25.0 \
#       --build-arg BASE_IMAGE=vllm-rocm-base:local \
#       --build-arg AITER_ROCM_ARCH="gfx942;gfx950;gfx1201" \
#       --build-arg VLLM_BASE_VERSION=0.25.0 \
#       --build-arg BUILD_VARIANT=hvat-gfx1201-scratch \
#       --progress=plain \
#       /home/yangecool/WorkSpace/Code/vLLM-v4-Craft
#
# Or:  bash docker/build_gfx1201_full.sh
#
# Wheel filename (example):
#   vllm-0.25.0+hvat-gfx1201-scratch.rocm723-cp312-cp312-linux_x86_64.whl

ARG BASE_IMAGE=vllm/vllm-openai-rocm:v0.25.0-base
ARG COMMON_WORKDIR=/app
ARG AITER_ROCM_ARCH=gfx942;gfx950;gfx1201

# Wheel version: {VLLM_BASE_VERSION}+{BUILD_VARIANT}.rocmXXX
ARG VLLM_BASE_VERSION=0.25.0
ARG BUILD_VARIANT=hvat-gfx1201-scratch

########################################################################
# base — install build tools on top of the pre-built base image.
########################################################################
FROM ${BASE_IMAGE} AS base

ARG PYTORCH_ROCM_ARCH
ENV PYTORCH_ROCM_ARCH=${PYTORCH_ROCM_ARCH:-${PYTORCH_ROCM_ARCH}}
ARG AITER_ROCM_ARCH
ENV AITER_ROCM_ARCH=${AITER_ROCM_ARCH}

# ---- APT mirror (ctyun) ---------------------------------------------------
RUN sed -i 's|http://archive.ubuntu.com|https://mirrors.ctyun.cn|g' /etc/apt/sources.list 2>/dev/null || true \
    && if [ -f /etc/apt/sources.list.d/ubuntu.sources ]; then \
         sed -i 's|http://.*archive.ubuntu.com|https://mirrors.ctyun.cn|g' /etc/apt/sources.list.d/ubuntu.sources \
         && sed -i 's|http://.*security.ubuntu.com|https://mirrors.ctyun.cn|g' /etc/apt/sources.list.d/ubuntu.sources; \
       fi

RUN apt-get update -q -y && apt-get install -q -y \
    sqlite3 libsqlite3-dev libfmt-dev libmsgpack-dev libsuitesparse-dev \
    apt-transport-https ca-certificates wget curl \
    libnuma-dev ccache mold \
    && rm -rf /var/lib/apt/lists/*

# Remove sccache (may be preinstalled in base image with S3 config).
ENV VLLM_DISABLE_SCCACHE=1
RUN apt-get purge -y sccache 2>/dev/null || true \
    && rm -f /usr/bin/sccache /bin/sccache /usr/local/bin/sccache \
    && hash -r 2>/dev/null || true
ENV SCCACHE_BUCKET=
ENV SCCACHE_REGION=
ENV SCCACHE_ENDPOINT=
ENV SCCACHE_S3_NO_CREDENTIALS=
ENV SCCACHE_IDLE_TIMEOUT=

# ---- PIP mirror (ctyun) ---------------------------------------------------
RUN python3 -m pip install --upgrade pip \
    && pip config set global.index-url https://mirrors.ctyun.cn/pypi/simple \
    && pip config set global.trusted-host mirrors.ctyun.cn

# UV — fast pip.
RUN curl -LsSf --retry 3 --retry-delay 5 https://astral.sh/uv/install.sh -o /tmp/uv-install.sh \
    && env UV_INSTALL_DIR="/usr/local/bin" sh /tmp/uv-install.sh \
    && rm -f /tmp/uv-install.sh \
    && uv --version
ENV UV_HTTP_TIMEOUT=500
ENV UV_INDEX_STRATEGY="unsafe-best-match"
ENV UV_LINK_MODE=copy
ENV CCACHE_DIR=/root/.cache/ccache
ENV CCACHE_COMPILERCHECK=content

ARG max_jobs
ENV MAX_JOBS=${max_jobs}

########################################################################
# build_aiter — compile aiter wheel from local source for gfx1201.
########################################################################
FROM base AS build_aiter

ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG NO_PROXY

WORKDIR /app
COPY aiter /app/aiter

RUN pip uninstall -y amd-aiter aiter 2>/dev/null || true

RUN if [ -n "$HTTP_PROXY" ]; then \
        git config --global http.proxy "$HTTP_PROXY" \
        && git config --global https.proxy "$HTTPS_PROXY"; \
    fi
RUN cd /app/aiter \
    && git submodule update --init --recursive \
    && pip install -r requirements.txt

# Without PREBUILD: JIT-compiles each kernel at runtime (avoids gfx950
# WMMA templates that fail on gfx1201).
RUN cd /app/aiter \
    && GPU_ARCHS=${AITER_ROCM_ARCH} \
       python3 setup.py bdist_wheel --dist-dir=dist \
    && ls /app/aiter/dist/*.whl
RUN mkdir -p /app/install && cp /app/aiter/dist/*.whl /app/install/

########################################################################
# fetch_vllm — local vllm source, write version string.
########################################################################
FROM base AS fetch_vllm
ARG COMMON_WORKDIR
WORKDIR ${COMMON_WORKDIR}
COPY vllm ${COMMON_WORKDIR}/vllm

ARG VLLM_BASE_VERSION
ARG BUILD_VARIANT
RUN cd ${COMMON_WORKDIR}/vllm \
    && echo "${VLLM_BASE_VERSION}+${BUILD_VARIANT}" > /tmp/vllm_version \
    && echo "vLLM version: $(cat /tmp/vllm_version)"

########################################################################
# rust-build — compile the vllm-rs frontend.
########################################################################
FROM fetch_vllm AS rust-build
ARG COMMON_WORKDIR
ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG NO_PROXY

RUN apt-get update -q -y && apt-get install -q -y --no-install-recommends \
        ca-certificates curl unzip \
    && rm -rf /var/lib/apt/lists/*
COPY vllm/tools/install_protoc.sh /tmp/install_protoc.sh
RUN /tmp/install_protoc.sh && rm /tmp/install_protoc.sh

ENV CARGO_BUILD_JOBS=4
ENV CARGO_NET_RETRY=10
ENV RUSTUP_MAX_RETRIES=10

# ---- Rust mirror (rsproxy) + Go proxy -------------------------------------
ENV RUSTUP_DIST_SERVER="https://rsproxy.cn"
ENV RUSTUP_UPDATE_ROOT="https://rsproxy.cn/rustup"
ENV GOPROXY="https://goproxy.cn,direct"
RUN mkdir -p /root/.cargo && cat > /root/.cargo/config.toml <<'EOF'
[source.crates-io]
replace-with = 'rsproxy-sparse'
[source.rsproxy]
registry = "https://rsproxy.cn/crates.io-index"
[source.rsproxy-sparse]
registry = "sparse+https://rsproxy.cn/index/"
[registries.rsproxy]
index = "https://rsproxy.cn/crates.io-index"
[net]
git-fetch-with-cli = true
EOF

RUN --mount=type=cache,id=vllm-rocm-uv,target=/root/.cache/uv \
    cd ${COMMON_WORKDIR}/vllm \
    && export SETUPTOOLS_SCM_PRETEND_VERSION=$(cat /tmp/vllm_version) \
    && uv pip install --system -r requirements/build/rust.txt

RUN --mount=type=cache,id=vllm-rocm-cargo-registry,target=/root/.cargo/registry,sharing=locked \
    --mount=type=cache,id=vllm-rocm-cargo-git,target=/root/.cargo/git,sharing=locked \
    cd ${COMMON_WORKDIR}/vllm \
    && export SETUPTOOLS_SCM_PRETEND_VERSION=$(cat /tmp/vllm_version) \
    && bash build_rust.sh \
    && test -x vllm/vllm-rs

########################################################################
# csrc-build — compile vllm ROCm native extensions.
########################################################################
FROM base AS csrc-build
ARG COMMON_WORKDIR
WORKDIR ${COMMON_WORKDIR}/vllm

COPY vllm/requirements/rocm.txt requirements/rocm.txt
COPY vllm/requirements/common.txt requirements/common.txt
RUN --mount=type=cache,id=vllm-rocm-uv,target=/root/.cache/uv \
    uv pip install --system -r requirements/rocm.txt

COPY vllm/setup.py vllm/CMakeLists.txt ./
COPY vllm/tools/build_rust.py tools/build_rust.py
COPY vllm/cmake cmake/
COPY vllm/csrc csrc/
COPY vllm/vllm/envs.py vllm/envs.py
COPY vllm/vllm/__init__.py vllm/__init__.py
COPY --from=fetch_vllm /tmp/vllm_version /tmp/vllm_version

ENV VLLM_TARGET_DEVICE=rocm

RUN --mount=type=bind,source=vllm/pyproject.toml,target=${COMMON_WORKDIR}/vllm/pyproject.toml \
    --mount=type=cache,id=vllm-rocm-ccache,target=/root/.cache/ccache \
    export CCACHE_BASEDIR="$PWD" \
    && export SETUPTOOLS_SCM_PRETEND_VERSION=$(cat /tmp/vllm_version) \
    && (ccache --zero-stats || true) \
    && EFFECTIVE_MAX_JOBS="${MAX_JOBS:-$(nproc)}" \
    && echo "Building ROCm native extension wheel with MAX_JOBS=${EFFECTIVE_MAX_JOBS}" \
    && LDFLAGS="-fuse-ld=mold" MAX_JOBS="${EFFECTIVE_MAX_JOBS}" python3 setup.py bdist_wheel --dist-dir=dist \
    && test -d dist \
    && ls dist/*.whl >/dev/null

########################################################################
# build_vllm — assemble full vllm wheel.
########################################################################
FROM fetch_vllm AS build_vllm
ARG COMMON_WORKDIR
ENV VLLM_TARGET_DEVICE=rocm

COPY --from=csrc-build ${COMMON_WORKDIR}/vllm/dist /precompiled-wheels
COPY --from=rust-build ${COMMON_WORKDIR}/vllm/vllm/vllm-rs ${COMMON_WORKDIR}/vllm/vllm/vllm-rs
COPY --from=rust-build ${COMMON_WORKDIR}/vllm/vllm/_rust_*.so ${COMMON_WORKDIR}/vllm/vllm/

RUN --mount=type=cache,id=vllm-rocm-uv,target=/root/.cache/uv \
    cd vllm \
    && export SETUPTOOLS_SCM_PRETEND_VERSION=$(cat /tmp/vllm_version) \
    && uv pip install --system -r requirements/rocm.txt \
    && export VLLM_USE_PRECOMPILED=1 \
    && export VLLM_PRECOMPILED_WHEEL_LOCATION="$(ls /precompiled-wheels/*.whl)" \
    && export VLLM_DOCKER_BUILD_CONTEXT=1 \
    && echo "Packaging vLLM ROCm wheel using precompiled extensions from ${VLLM_PRECOMPILED_WHEEL_LOCATION}" \
    && python3 setup.py bdist_wheel --dist-dir=dist \
    && test -d dist \
    && ls dist/*.whl >/dev/null

########################################################################
# final — install aiter + vllm wheels.
########################################################################
FROM base AS final
ARG COMMON_WORKDIR

RUN python3 -m pip install --upgrade pip

# Replace any pre-existing aiter with our gfx1201 build.
RUN --mount=type=bind,from=build_aiter,src=/app/install,target=/aiter_install \
    pip uninstall -y amd-aiter aiter 2>/dev/null || true \
    && pip install /aiter_install/*.whl

# Install the freshly compiled vllm wheel.
RUN --mount=type=bind,from=build_vllm,src=${COMMON_WORKDIR}/vllm/dist,target=/vllm_install \
    --mount=type=cache,target=/root/.cache/uv \
    pip uninstall -y vllm 2>/dev/null || true \
    && uv pip install --system /vllm_install/*.whl

# Runtime environment (match upstream).
ENV HSA_ENABLE_IPC_MODE_LEGACY=1
ENV TOKENIZERS_PARALLELISM=false
ENV SAFETENSORS_FAST_GPU=1
ENV HIP_FORCE_DEV_KERNARG=1
ENV PYTORCH_NVML_BASED_CUDA_CHECK=1

# Clear build-time env vars.
ENV MAX_JOBS=
ENV CCACHE_DIR=
ENV CCACHE_COMPILERCHECK=

WORKDIR ${COMMON_WORKDIR}/vllm
ENTRYPOINT ["vllm", "serve"]
CMD ["/bin/bash"]
